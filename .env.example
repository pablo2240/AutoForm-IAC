# ==============================================================================
# AUTOFORM AI — PLANTILLA DE VARIABLES DE ENTORNO (.env.example)
# Copia este archivo como .env y completa los valores correspondientes.
# NUNCA compartas ni subas tu archivo .env con credenciales reales a git.
# ==============================================================================

# Entorno de ejecución de la aplicación: 'production', 'staging' o 'development'
# En production y staging: Supabase es la ÚNICA fuente de verdad obligatoria (SQLite bloqueado fail-closed).
# En development: Permite uso de SQLite local para transición offline.
APP_ENVIRONMENT=staging

# ── SUPABASE (PostgreSQL + Supabase Auth) ──────────────────────────────────────
# URL base de tu proyecto en Supabase (ej. https://abcdefghijklmno.supabase.co)
SUPABASE_URL=https://your-project-ref.supabase.co

# Llave pública moderna (Publishable API Key: sb_publishable_...)
# Se utiliza en el cliente frontend para login de usuarios y consultas con RLS.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Llave secreta moderna (Secret API Key: sb_secret_...)
# ¡ALTA SEGURIDAD! Uso exclusivo en el servidor backend para migraciones y operaciones de administración.
# NUNCA debe exponerse al navegador, frontend, logs ni consola.
SUPABASE_SECRET_KEY=sb_secret_...

# Claves legacy (compatibilidad retroactiva si no se han configurado las modernas):
# SUPABASE_ANON_KEY=eyJhbGciOi...
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Project Reference de Staging para allowlist estricta de ejecución y rollback
AUTOFORM_EXCEL_STAGING_PROJECT_REF=your-project-ref

# ── OPENAI API (Mapeo Semántico) ──────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1-mini

# ── OPCIONES DE DESARROLLO LOCAL ──────────────────────────────────────────────
# Solo aplica si APP_ENVIRONMENT=development
USE_SQLITE=false
# Contraseña para inicialización de la cuenta administrativa local en SQLite (obligatoria si USE_SQLITE=true e inicializar_db crea usuarios)
# AUTOFORM_ADMIN_PASSWORD=tu_contraseña_admin_local
