# ==============================================================================
# AUTOFORM AI — PLANTILLA DE VARIABLES DE ENTORNO (.env.example)
# Copia este archivo como .env y completa los valores correspondientes.
# NUNCA compartas ni subas tu archivo .env con credenciales reales a git.
# ==============================================================================

# Entorno de ejecución de la aplicación: 'production' o 'development'
# En production: Supabase es la ÚNICA fuente de verdad obligatoria.
# En development: Permite uso de SQLite local para transición offline.
APP_ENVIRONMENT=production

# ── SUPABASE (PostgreSQL + Supabase Auth) ──────────────────────────────────────
# URL base de tu proyecto en Supabase (ej. https://abcdefghijklmno.supabase.co)
SUPABASE_URL=https://your-project-ref.supabase.co

# Llave anónima pública (Anon / Public API Key).
# Se utiliza en el cliente frontend para login de usuarios y consultas con RLS.
SUPABASE_ANON_KEY=eyJhbGciOi...

# Llave de rol de servicio (Service Role / Admin Key).
# ¡ALTA SEGURIDAD! Uso exclusivo en el servidor para migraciones e invitaciones.
# NUNCA debe exponerse al navegador, logs, consola ni código cliente.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Project Reference de Staging para allowlist estricta de ejecución y rollback
AUTOFORM_EXCEL_STAGING_PROJECT_REF=your-project-ref

# ── OPENAI API (Mapeo Semántico) ──────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1-mini

# ── OPCIONES DE DESARROLLO LOCAL ──────────────────────────────────────────────
# Solo aplica si APP_ENVIRONMENT=development
USE_SQLITE=false
